// Where `wrangler deploy` deploys dist/, which it builds first: a Cloudflare Worker that only serves static assets.
{
  "name": "hookedin-blackjack-game",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "dist" },
  "build": { "command": "npm run build" },
  "routes": [{ "pattern": "blackjack-game.hookedin.com", "custom_domain": true }],
}
