{
  "name": "@hookedin/game-blackjack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:hookedin/game-blackjack",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run generate && hookedin-game build",
    "dev": "npm run generate && hookedin-game serve",
    "generate": "node --import tsx scripts/funding.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run generate && npm run typecheck && node --import tsx --test test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookedin/play": "git+https://github.com/hookedin/play.git#main"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
